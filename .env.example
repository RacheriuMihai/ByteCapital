# Copy this file to .env (which is git-ignored) and fill it in.
# Never commit .env or paste the token into code, issues or chat.

# Value of the X-SK-API header from any /api/history request in the Network tab of bvb.ro
BVB_WAPI_TOKEN=

# Optional: override the browser User-Agent sent with requests
# BVB_USER_AGENT=
